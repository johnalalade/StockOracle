# Server
PORT=4000

# Anthropic Claude — used by the LLM fundamental analyzer.
# If unset, the system automatically falls back to a deterministic
# finance-lexicon heuristic, so the app still works without a key.
ANTHROPIC_API_KEY=
# Model used for deterministic (temperature 0) fundamental extraction.
# Options: claude-haiku-4-5-20251001 (fast/cheap), claude-sonnet-4-6, claude-opus-4-8
LLM_MODEL=claude-haiku-4-5-20251001

# EODHD — primary live market-data provider (works from Vercel/datacenters).
# Get a key at https://eodhd.com. When set, prices come from EODHD first, then
# AFX scraping, then the bundled snapshot. When unset, EODHD is skipped.
EODHD_API_KEY=
# Nigerian Exchange code on EODHD (MIC XNSA). If EODHD returns "no data" for a
# known ticker, verify the code for your plan via:
#   https://eodhd.com/api/exchange-symbol-list/XNSA?api_token=YOUR_KEY&fmt=json
EODHD_EXCHANGE=XNSA
# Days of daily history to request from EODHD (deeper = better indicators).
EODHD_HISTORY_DAYS=400

# How long (ms) to cache scraped market/news data before re-fetching.
MARKET_CACHE_MS=300000
NEWS_CACHE_MS=900000
